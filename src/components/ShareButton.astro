---
import QRCode from 'qrcode';

type Props = {
  title: string;
  description?: string;
  url: string;
};

const { title, description, url } = Astro.props as Props;
const qrCodeSvg = await QRCode.toString(url, {
  type: 'svg',
  width: 220,
  margin: 2,
  color: {
    dark: '#0f172a',
    light: '#ffffff'
  }
});
---

<div class="mt-5" data-share-root>
  <button
    type="button"
    class="rounded-lg border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
    data-share-open
  >
    分享
  </button>

  <div
    class="fixed inset-0 z-50 hidden bg-slate-900/25 px-4 py-6"
    data-share-overlay
    hidden
  >
    <div
      class="mx-auto mt-16 w-full max-w-sm rounded-lg border border-slate-200 bg-white p-5 text-slate-900 shadow-lg"
      role="dialog"
      aria-modal="true"
      aria-label="分享文章"
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-sm font-semibold">分享文章</p>
          <h2 class="mt-1 text-base font-semibold leading-snug">{title}</h2>
          {description ? <p class="mt-2 text-sm leading-6 text-slate-600">{description}</p> : null}
        </div>
        <button
          type="button"
          class="rounded-lg px-2 py-1 text-sm text-slate-500 hover:bg-slate-100 hover:text-slate-900"
          aria-label="关闭分享弹窗"
          data-share-close
        >
          关闭
        </button>
      </div>

      <div class="mx-auto mt-5 flex h-56 w-56 items-center justify-center rounded-lg border border-slate-200 bg-white p-3" aria-label="文章二维码" set:html={qrCodeSvg} />

      <label class="mt-5 block text-sm font-medium text-slate-700" for="share-url">文章链接</label>
      <input
        id="share-url"
        class="mt-2 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700"
        value={url}
        readonly
        data-share-url
      />

      <div class="mt-4 flex items-center justify-between gap-3">
        <p class="text-sm text-slate-500" aria-live="polite" data-share-status>扫码或复制链接分享。</p>
        <button
          type="button"
          class="rounded-lg bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700"
          data-share-copy
          data-default-label="复制链接"
        >
          复制链接
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const roots = document.querySelectorAll<HTMLElement>('[data-share-root]');

  for (const root of roots) {
    if (root.dataset.shareReady === 'true') {
      continue;
    }

    root.dataset.shareReady = 'true';

    const openButton = root.querySelector<HTMLButtonElement>('[data-share-open]');
    const overlay = root.querySelector<HTMLElement>('[data-share-overlay]');
    const closeButtons = root.querySelectorAll<HTMLButtonElement>('[data-share-close]');
    const copyButton = root.querySelector<HTMLButtonElement>('[data-share-copy]');
    const urlInput = root.querySelector<HTMLInputElement>('[data-share-url]');
    const status = root.querySelector<HTMLElement>('[data-share-status]');

    if (!openButton || !overlay || !copyButton || !urlInput || !status) {
      continue;
    }

    const openDialog = () => {
      overlay.hidden = false;
      overlay.classList.remove('hidden');
      closeButtons[0]?.focus();
    };

    const closeDialog = () => {
      overlay.hidden = true;
      overlay.classList.add('hidden');
      openButton.focus();
    };

    const setCopied = () => {
      const defaultLabel = copyButton.dataset.defaultLabel || '复制链接';
      copyButton.textContent = '已复制';
      status.textContent = '链接已复制。';
      window.setTimeout(() => {
        copyButton.textContent = defaultLabel;
        status.textContent = '扫码或复制链接分享。';
      }, 1800);
    };

    const copyLink = async () => {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(urlInput.value);
        } else {
          urlInput.select();
          document.execCommand('copy');
          urlInput.setSelectionRange(0, 0);
        }
        setCopied();
      } catch {
        urlInput.focus();
        urlInput.select();
        status.textContent = '请手动复制链接。';
      }
    };

    openButton.addEventListener('click', openDialog);
    copyButton.addEventListener('click', copyLink);

    for (const closeButton of closeButtons) {
      closeButton.addEventListener('click', closeDialog);
    }

    overlay.addEventListener('click', (event) => {
      if (event.target === overlay) {
        closeDialog();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !overlay.hidden) {
        closeDialog();
      }
    });
  }
</script>
