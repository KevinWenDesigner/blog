---
import type { BlogPost } from '../lib/astroPosts';

type Props = {
  posts: BlogPost[];
};

const { posts } = Astro.props as Props;
---

{posts.length > 0 ? (
  <section class="mt-12 border-t border-slate-200 pt-8">
    <h2 class="text-lg font-semibold tracking-tight">相关文章</h2>
    <div class="mt-4 grid gap-3">
      {posts.map((post) => (
        <a class="rounded-lg border border-slate-200 p-4 hover:bg-slate-50" href={`${import.meta.env.BASE_URL}blog/${post.id}/`}>
          <span class="text-sm font-medium text-slate-900">{post.data.title}</span>
          <span class="mt-1 block text-sm text-slate-600">{post.data.description}</span>
        </a>
      ))}
    </div>
  </section>
) : null}
