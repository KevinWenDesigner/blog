---
type SourceInfo = {
  platform: 'youtube';
  videoId: string;
  url: string;
  channel: string;
  originalTitle: string;
  publishedAt: string;
  thumbnail?: string;
};

type Props = {
  source: SourceInfo;
};

const { source } = Astro.props as Props;
const publishedLabel = new Intl.DateTimeFormat('zh-CN', { dateStyle: 'long' }).format(new Date(source.publishedAt));
---

<aside class="mb-6 rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300">
  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">来源</p>
  <p class="mt-2 leading-relaxed">
    本文由自动化流程基于公开视频字幕生成，适合快速浏览要点，建议结合原视频交叉阅读。
  </p>
  <dl class="mt-3 space-y-2">
    <div>
      <dt class="font-medium text-slate-900 dark:text-slate-100">平台</dt>
      <dd>YouTube</dd>
    </div>
    <div>
      <dt class="font-medium text-slate-900 dark:text-slate-100">频道</dt>
      <dd>{source.channel}</dd>
    </div>
    <div>
      <dt class="font-medium text-slate-900 dark:text-slate-100">原视频</dt>
      <dd>
        <a class="hover:underline dark:hover:text-slate-200" href={source.url} rel="noreferrer" target="_blank">
          {source.originalTitle}
        </a>
      </dd>
    </div>
    <div>
      <dt class="font-medium text-slate-900 dark:text-slate-100">视频发布时间</dt>
      <dd>{publishedLabel}</dd>
    </div>
  </dl>
</aside>
