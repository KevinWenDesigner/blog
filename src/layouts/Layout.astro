---
import '../styles/global.css';
import { resolvePageMeta } from '../lib/layoutMeta';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: Date;
};

const { title = '技术笔记', description, image, articleDate } = Astro.props as Props;
const baseUrl = import.meta.env.BASE_URL;
const pageMeta = resolvePageMeta({
  site: Astro.site,
  pathname: Astro.url.pathname,
  baseUrl,
  description,
  image,
  articleDate
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title="技术笔记 RSS" href={`${baseUrl}rss.xml`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageMeta.description} />
    <title>{title}</title>

    <link rel="canonical" href={pageMeta.canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={pageMeta.ogType} />
    <meta property="og:url" content={pageMeta.canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageMeta.description} />
    <meta property="og:image" content={pageMeta.ogImage} />
    {pageMeta.publishedTime ? <meta property="article:published_time" content={pageMeta.publishedTime} /> : null}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={pageMeta.canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={pageMeta.description} />
    <meta property="twitter:image" content={pageMeta.ogImage} />

    <!-- Dark Mode Anti-Flash -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-dvh bg-white text-slate-900 antialiased transition-colors duration-300 dark:bg-slate-950 dark:text-slate-200">
    <main class="mx-auto w-full max-w-3xl px-4 py-12">
      <header class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <a href={baseUrl} class="text-base font-semibold tracking-tight">
          技术笔记
        </a>
        <div class="flex items-center gap-4">
          <nav class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-600 dark:text-slate-400">
            <a class="hover:text-slate-900 dark:hover:text-slate-100" href={`${baseUrl}blog/`}>文章</a>
            <a class="hover:text-slate-900 dark:hover:text-slate-100" href={`${baseUrl}search/`}>搜索</a>
            <a class="hover:text-slate-900 dark:hover:text-slate-100" href={`${baseUrl}tags/`}>标签</a>
            <a class="hover:text-slate-900 dark:hover:text-slate-100" href={`${baseUrl}categories/`}>分类</a>
            <a class="hover:text-slate-900 dark:hover:text-slate-100" href={`${baseUrl}archive/`}>归档</a>
          </nav>

          <button
            id="theme-toggle"
            class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-slate-900"
            aria-label="切换主题"
          >
            <!-- Sun Icon -->
            <svg id="theme-toggle-light-icon" class="hidden h-5 w-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
              <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
            </svg>
            <!-- Moon Icon -->
            <svg id="theme-toggle-dark-icon" class="hidden h-5 w-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
              <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
            </svg>
          </button>
        </div>
      </header>
      <slot />
      <footer class="mt-16 border-t border-slate-200 pt-6 text-sm text-slate-500 dark:border-slate-800">
        <a class="hover:text-slate-900 hover:underline dark:hover:text-slate-100" href={`${baseUrl}rss.xml`}>订阅 RSS</a>
      </footer>
    </main>

    <script>
      import { copyTextWithFallback } from '../lib/copyText';

      // Theme Toggle Logic
      const themeToggleBtn = document.getElementById('theme-toggle');
      const lightIcon = document.getElementById('theme-toggle-light-icon');
      const darkIcon = document.getElementById('theme-toggle-dark-icon');

      // Update Icons
      function updateIcons() {
        if (document.documentElement.classList.contains('dark')) {
          lightIcon.classList.remove('hidden');
          darkIcon.classList.add('hidden');
        } else {
          lightIcon.classList.add('hidden');
          darkIcon.classList.remove('hidden');
        }
      }
      updateIcons();

      themeToggleBtn.addEventListener('click', () => {
        document.documentElement.classList.toggle('dark');
        const isDark = document.documentElement.classList.contains('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateIcons();
      });

      // Code Copy Button Logic
      function addCopyButtons() {
        const blocks = document.querySelectorAll('pre');
        blocks.forEach((block) => {
          if (block.querySelector('.copy-button')) return;

          block.style.position = 'relative';
          const button = document.createElement('button');
          button.className = 'copy-button absolute right-3 top-3 rounded-md bg-slate-800 p-1.5 text-slate-400 hover:bg-slate-700 hover:text-white focus:outline-none transition-all duration-200';
          button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';

          button.addEventListener('click', async () => {
            const code = block.querySelector('code')?.innerText || block.innerText;
            const copied = await copyTextWithFallback(code, {
              clipboard: navigator.clipboard,
              document,
              onBeforeExecCommand: () => {
                const selection = window.getSelection();
                selection?.removeAllRanges();

                const range = document.createRange();
                range.selectNodeContents(block);
                selection?.addRange(range);
              },
              onAfterExecCommand: () => {
                window.getSelection()?.removeAllRanges();
              }
            });

            if (!copied) {
              button.setAttribute('aria-label', '请手动复制代码');
              return;
            }

            button.setAttribute('aria-label', '代码已复制');
              button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="green" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
              setTimeout(() => {
                button.removeAttribute('aria-label');
                button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
              }, 2000);
          });

          block.appendChild(button);
        });
      }
      addCopyButtons();

      // Support for View Transitions
      document.addEventListener('astro:after-swap', () => {
        updateIcons();
        addCopyButtons();
      });
    </script>
  </body>
</html>

