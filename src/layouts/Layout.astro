---
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
};

const { title = '技术笔记', description } = Astro.props as Props;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title="技术笔记 RSS" href={`${baseUrl}rss.xml`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description ? <meta name="description" content={description} /> : null}
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="min-h-dvh bg-white text-slate-900 antialiased">
    <main class="mx-auto w-full max-w-3xl px-4 py-12">
      <header class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <a href={baseUrl} class="text-base font-semibold tracking-tight">
          技术笔记
        </a>
        <nav class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-600">
          <a class="hover:text-slate-900" href={`${baseUrl}blog/`}>文章</a>
          <a class="hover:text-slate-900" href={`${baseUrl}search/`}>搜索</a>
          <a class="hover:text-slate-900" href={`${baseUrl}tags/`}>标签</a>
          <a class="hover:text-slate-900" href={`${baseUrl}categories/`}>分类</a>
          <a class="hover:text-slate-900" href={`${baseUrl}archive/`}>归档</a>
          <a class="hover:text-slate-900" href={`${baseUrl}rss.xml`}>RSS</a>
        </nav>
      </header>
      <slot />
      <footer class="mt-16 border-t border-slate-200 pt-6 text-sm text-slate-500">
        <a class="hover:text-slate-900 hover:underline" href={`${baseUrl}rss.xml`}>订阅 RSS</a>
      </footer>
    </main>
  </body>
</html>

