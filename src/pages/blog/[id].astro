---
import PostNav from '../../components/PostNav.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import ShareButton from '../../components/ShareButton.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Comments from '../../components/Comments.astro';
import Layout from '../../layouts/Layout.astro';
import { render } from 'astro:content';
import { getPublishedBlogPosts } from '../../lib/astroPosts';
import { getAdjacentPosts, getReadingMinutes, getRelatedPosts } from '../../lib/posts';
import { buildArticleShareUrl } from '../../lib/share';

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, posts }
  }));
}

const { post, posts } = Astro.props as {
  post: Awaited<ReturnType<typeof getPublishedBlogPosts>>[number];
  posts: Awaited<ReturnType<typeof getPublishedBlogPosts>>;
};

const { Content, headings } = await render(post);
const dateLabel = new Intl.DateTimeFormat('zh-CN', { dateStyle: 'long' }).format(post.data.pubDate);
const updatedLabel = post.data.updatedDate
  ? new Intl.DateTimeFormat('zh-CN', { dateStyle: 'long' }).format(post.data.updatedDate)
  : undefined;
const readingMinutes = getReadingMinutes(post.body);
const { newer, older } = getAdjacentPosts(posts, post.id);
const relatedPosts = getRelatedPosts(posts, post);
const shareUrl = buildArticleShareUrl({
  site: Astro.site,
  basePath: import.meta.env.BASE_URL,
  postId: post.id
});
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="leading-relaxed" data-pagefind-body>
    <header class="mb-8">
      <h1 class="text-3xl font-semibold tracking-tight">{post.data.title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-slate-600">
        <time datetime={post.data.pubDate.toISOString()}>{dateLabel}</time>
        <span class="text-slate-300">·</span>
        <span>{readingMinutes} 分钟阅读</span>
        {updatedLabel ? (
          <>
            <span class="text-slate-300">·</span>
            <time datetime={post.data.updatedDate?.toISOString()}>更新于 {updatedLabel}</time>
          </>
        ) : null}
        <span class="text-slate-300">·</span>
        <a class="hover:underline" href={`${import.meta.env.BASE_URL}categories/${encodeURIComponent(post.data.category)}/`}>
          {post.data.category}
        </a>
        {post.data.tags.map((tag) => (
          <a class="hover:underline" href={`${import.meta.env.BASE_URL}tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
        ))}
      </div>
      {post.data.keywords.length > 0 ? <p class="sr-only">关键词：{post.data.keywords.join('，')}</p> : null}
      <ShareButton title={post.data.title} description={post.data.description} url={shareUrl} />
    </header>

    <TableOfContents headings={headings} />
    <div class="article-body">
      <Content />
    </div>
  </article>
  <RelatedPosts posts={relatedPosts} />
  <PostNav newer={newer} older={older} />
  {post.data.comments ? <Comments /> : null}
</Layout>
