---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedBlogPosts } from '../../lib/astroPosts';

const posts = await getPublishedBlogPosts();
---

<Layout title="文章">
  <h1 class="text-3xl font-semibold tracking-tight">文章</h1>
  <p class="mt-3 text-slate-600">全部文章（按时间倒序），共 {posts.length} 篇。</p>

  {posts.length > 0 ? (
    <div class="mt-10 grid gap-4">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  ) : (
    <p class="mt-10 rounded-lg border border-slate-200 p-4 text-sm text-slate-600">还没有发布文章。</p>
  )}
</Layout>
