---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面未找到" description="这个地址没有对应的文章或页面。">
  <section class="py-10">
    <p class="text-sm font-medium text-slate-500">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">页面未找到</h1>
    <p class="mt-3 text-slate-600">这个地址没有对应的文章或页面。</p>
    <div class="mt-8 flex flex-wrap gap-3 text-sm font-medium">
      <a class="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700" href={import.meta.env.BASE_URL}>回到首页</a>
      <a class="rounded-lg border border-slate-200 px-4 py-2 text-slate-700 hover:bg-slate-50" href={`${import.meta.env.BASE_URL}search/`}>搜索笔记</a>
    </div>
  </section>
</Layout>
