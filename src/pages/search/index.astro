---
import Layout from '../../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="搜索" description="搜索技术笔记正文、标题和关键词。">
  <Fragment slot="head">
    <link href={`${baseUrl}pagefind/pagefind-component-ui.css`} rel="stylesheet" />
    <script src={`${baseUrl}pagefind/pagefind-component-ui.js`} type="module"></script>
  </Fragment>

  <h1 class="text-3xl font-semibold tracking-tight">搜索</h1>
  <p class="mt-3 text-slate-600">输入关键词，快速找回旧问题、代码片段和学习笔记。</p>

  <section class="mt-10">
    <pagefind-config preload bundle-path={`${baseUrl}pagefind/`} base-url={baseUrl} lang="zh"></pagefind-config>
    <pagefind-input placeholder="搜索 Astro、自动化、踩坑记录..."></pagefind-input>
    <pagefind-summary class="mt-4 block text-sm text-slate-600"></pagefind-summary>
    <pagefind-results class="mt-6 block"></pagefind-results>
  </section>
</Layout>
