---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedBlogPosts } from '../../lib/astroPosts';
import { groupByCategory, sortByPubDateDesc } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();
  const byCategory = groupByCategory(posts);

  return [...byCategory.entries()].map(([category, items]) => ({
    params: { category },
    props: { category, posts: sortByPubDateDesc(items) }
  }));
}

const { category, posts } = Astro.props as {
  category: string;
  posts: Awaited<ReturnType<typeof getPublishedBlogPosts>>;
};
---

<Layout title={`分类：${category}`}>
  <h1 class="text-3xl font-semibold tracking-tight">{category}</h1>
  <p class="mt-3 text-slate-600">该分类下的全部文章。</p>

  <div class="mt-10 grid gap-4">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</Layout>

