---
import Layout from '../../layouts/Layout.astro';
import { getPublishedBlogPosts } from '../../lib/astroPosts';
import { groupByYearMonth, sortByPubDateDesc } from '../../lib/posts';

const posts = await getPublishedBlogPosts();
const byYm = groupByYearMonth(posts);
const groups = [...byYm.entries()]
  .map(([ym, items]) => ({ ym, items: sortByPubDateDesc(items) }))
  .sort((a, b) => b.ym.localeCompare(a.ym));
---

<Layout title="归档">
  <h1 class="text-3xl font-semibold tracking-tight">归档</h1>
  <p class="mt-3 text-slate-600">按时间浏览文章。</p>

  <div class="mt-10 space-y-10">
    {groups.map(({ ym, items }) => (
      <section>
        <h2 class="text-base font-semibold">{ym}</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {items.map((post) => (
            <li class="flex items-baseline justify-between gap-4">
              <a class="hover:underline" href={`/blog/${post.id}/`}>{post.data.title}</a>
              <time class="shrink-0 text-xs text-slate-500" datetime={post.data.pubDate.toISOString()}>
                {new Intl.DateTimeFormat('zh-CN', { dateStyle: 'short' }).format(post.data.pubDate)}
              </time>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Layout>

