---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedBlogPosts } from '../lib/astroPosts';

const posts = await getPublishedBlogPosts();
const recent = posts.slice(0, 5);
---

<Layout title="技术笔记" description="个人技术学习笔记：教程、踩坑与读书笔记。">
	<h1 class="text-4xl font-semibold tracking-tight dark:text-slate-100">技术笔记</h1>
	<p class="mt-3 text-slate-600 dark:text-slate-400">教程、踩坑与读书笔记。把解决过的问题留给未来的自己。</p>

	<div class="mt-8 flex flex-wrap gap-3 text-sm font-medium">
		<a class="rounded-lg bg-slate-900 px-4 py-2 text-white hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-300" href={`${import.meta.env.BASE_URL}search/`}>搜索笔记</a>
		<a class="rounded-lg border border-slate-200 px-4 py-2 text-slate-700 hover:bg-slate-50 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-slate-900" href={`${import.meta.env.BASE_URL}archive/`}>查看归档</a>
	</div>

	<section class="mt-10 space-y-4">
		<div class="flex items-baseline justify-between gap-4">
			<h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">最近文章</h2>
			<span class="text-sm text-slate-500">{posts.length} 篇</span>
		</div>
		{recent.length > 0 ? (
			<>
				<div class="mt-4 grid gap-4">
					{recent.map((post) => <PostCard post={post} />)}
				</div>
				<div class="pt-2">
					<a class="text-sm font-medium text-slate-700 hover:underline dark:text-slate-300" href={`${import.meta.env.BASE_URL}blog/`}>查看全部文章 →</a>
				</div>
			</>
		) : (
			<p class="rounded-lg border border-slate-200 p-4 text-sm text-slate-600 dark:border-slate-800 dark:text-slate-400">还没有发布文章。</p>
		)}
	</section>
</Layout>
