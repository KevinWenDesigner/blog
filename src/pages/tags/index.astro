---
import Layout from '../../layouts/Layout.astro';
import { getPublishedBlogPosts } from '../../lib/astroPosts';
import { groupByTag } from '../../lib/posts';

const posts = await getPublishedBlogPosts();
const byTag = groupByTag(posts);
const tags = [...byTag.entries()]
  .map(([tag, tagged]) => ({ tag, count: tagged.length }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag, 'zh-CN'));
---

<Layout title="标签">
  <h1 class="text-3xl font-semibold tracking-tight">标签</h1>
  <p class="mt-3 text-slate-600">按标签浏览文章。</p>

  <div class="mt-10 flex flex-wrap gap-2">
    {tags.map(({ tag, count }) => (
      <a
        class="rounded-full border border-slate-200 bg-white px-3 py-1 text-sm text-slate-700 shadow-sm hover:bg-slate-50"
        href={`/tags/${encodeURIComponent(tag)}/`}
      >
        {tag}
        <span class="ml-2 text-xs text-slate-500">({count})</span>
      </a>
    ))}
  </div>
</Layout>

