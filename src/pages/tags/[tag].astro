---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedBlogPosts } from '../../lib/astroPosts';
import { groupByTag, sortByPubDateDesc } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();
  const byTag = groupByTag(posts);

  return [...byTag.entries()].map(([tag, tagged]) => ({
    params: { tag },
    props: { tag, posts: sortByPubDateDesc(tagged) }
  }));
}

const { tag, posts } = Astro.props as {
  tag: string;
  posts: Awaited<ReturnType<typeof getPublishedBlogPosts>>;
};
---

<Layout title={`标签：${tag}`}>
  <h1 class="text-3xl font-semibold tracking-tight">#{tag}</h1>
  <p class="mt-3 text-slate-600">该标签下的全部文章。</p>

  <div class="mt-10 grid gap-4">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</Layout>

